# Copy to .env and fill in for local development.
# Never commit a real .env file.

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Max JSON body size accepted by the API, in bytes
API_BODY_LIMIT_BYTES=102400
# Requests allowed per IP per RATE_LIMIT_WINDOW_MS
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Web
WEB_PORT=3000
# Server-side only: base URL the Next.js server uses to reach the API.
# Never exposed to the browser (no NEXT_PUBLIC_ prefix).
INTERNAL_API_BASE_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_concierge

# Redis
REDIS_URL=redis://localhost:6379

# Outbound network allowlist (SSRF protection), comma-separated hostnames
OUTBOUND_ALLOWED_HOSTS=localhost,127.0.0.1

# Webhook signature secret (HMAC), placeholder only — replace per channel in later phases
WEBHOOK_SIGNING_SECRET=change-me-in-production

# OpenTelemetry — leave unset to disable exporting (Phase 1 default: NOT_CONFIGURED)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-concierge

# Multi-tenancy — default tenant used until Phase 2 tenant management ships
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
