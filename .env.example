# Copy to .env and fill in for local development.
# Never commit a real .env file.

NODE_ENV=development
LOG_LEVEL=info

# API
# Most PaaS providers (Render, Heroku, ...) assign this via their own PORT
# variable instead — apps/api/src/env.ts adopts PORT automatically when
# API_PORT itself isn't set, so you don't need to set this in production.
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Max JSON body size accepted by the API, in bytes
API_BODY_LIMIT_BYTES=102400
# Requests allowed per IP per RATE_LIMIT_WINDOW_MS
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Web
WEB_PORT=3000
# Server-side only: base URL the Next.js server uses to reach the API.
# Never exposed to the browser (no NEXT_PUBLIC_ prefix).
INTERNAL_API_BASE_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_concierge

# Redis
REDIS_URL=redis://localhost:6379

# Outbound network allowlist (SSRF protection), comma-separated hostnames
OUTBOUND_ALLOWED_HOSTS=localhost,127.0.0.1

# Webhook signature secret (HMAC), placeholder only — replace per channel in later phases
WEBHOOK_SIGNING_SECRET=change-me-in-production

# OpenTelemetry — leave unset to disable exporting (Phase 1 default: NOT_CONFIGURED)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-concierge

# Multi-tenancy — default tenant used until Phase 2 tenant management ships
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# WhatsApp (Meta Cloud API) — leave all unset to keep the channel
# NOT_CONFIGURED (webhook rejects inbound, no outbound sends are attempted).
# 1. Create a Meta App -> add the WhatsApp product -> API Setup page.
# 2. WHATSAPP_PHONE_NUMBER_ID: the "Phone number ID" shown there (not the
#    phone number itself).
# 3. WHATSAPP_ACCESS_TOKEN: a token for that number (use a permanent System
#    User token for anything beyond a quick test — the default one expires
#    in 24h).
# 4. WHATSAPP_APP_SECRET: App Dashboard -> Settings -> Basic -> App Secret.
#    Used to verify the X-Hub-Signature-256 header on every inbound webhook.
# 5. WHATSAPP_VERIFY_TOKEN: any string you choose yourself. When you
#    register the webhook URL (https://<your-api-host>/webhooks/whatsapp) in
#    Meta's dashboard, paste this same value into its "Verify token" field.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Phase 6 — Availability. FLEET_PROVIDER=database (default) needs no other
# configuration: it counts real VehicleUnit rows in our own database, which
# is always the source of truth. Set FLEET_PROVIDER=external only if a
# third-party fleet-management API should supply unit counts instead; left
# unconfigured, it reports NOT_CONFIGURED rather than a fake integration.
FLEET_PROVIDER=database
FLEET_API_BASE_URL=
FLEET_API_KEY=
FLEET_API_TIMEOUT_MS=3000
# How long a temporary hold survives before it lapses back to available capacity.
AVAILABILITY_HOLD_TTL_SECONDS=900
# Turnaround buffer (minutes) applied to both ends of an overlap check (cleaning/inspection window).
AVAILABILITY_TURNAROUND_BUFFER_MINUTES=120
# How often the worker's housekeeping sweep flips lapsed holds to EXPIRED (never load-bearing for correctness).
HOLD_EXPIRATION_SWEEP_INTERVAL_MS=60000

# Phase 6 — AuthN/AuthZ. Both required; unlike the provider seams above there
# is no NOT_CONFIGURED state for staff login. The values below are randomly
# generated for local dev only — regenerate real ones before any non-local
# deployment (never reuse these, they are public in version control):
#   JWT_SIGNING_SECRET: any random string >= 32 characters
#   MFA_ENCRYPTION_KEY: base64 for exactly 32 bytes, e.g.
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SIGNING_SECRET=change-me-in-production-min-32-characters-long-value
MFA_ENCRYPTION_KEY=zsqFPLXxhE2jMyWnSscCoupYiPB3Mi1V7cuiAh0FR4I=
AUTH_TOKEN_ISSUER=AI Concierge
# Brute-force protection scoped to /v1/auth/login and /v1/auth/refresh,
# stricter than the app-wide RATE_LIMIT_MAX/_WINDOW_MS above.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Least-privilege DB roles (packages/db/prisma/migrations/..._add_security_engine).
# See docs/SECURITY-MODEL.md for why local dev/CI still default DATABASE_URL
# to the superuser connection instead of these — production should not.
# DIRECT_DATABASE_URL (superuser) is for `prisma migrate deploy` only, once
# DATABASE_URL itself is switched to a scoped role.
# DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_concierge
