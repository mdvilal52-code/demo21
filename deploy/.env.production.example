# Copy to .env.production on the VM and fill in real values — never commit
# the filled-in file. Loaded by sourcing it before `pm2 start` (see
# ecosystem.config.js and oracle-vm-setup.sh).

NODE_ENV=production
LOG_LEVEL=info

# Postgres + Redis run on this same VM via docker-compose.yml (repo root) —
# these match its default credentials/port, unchanged.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_concierge
REDIS_URL=redis://localhost:6379

# Generate your own: openssl rand -base64 32
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_16_CHARS

# Must match a real seeded Tenant row (packages/testing's seedTestTenants
# uses this same id in tests; production needs its own seeded row).
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

OUTBOUND_ALLOWED_HOSTS=localhost,127.0.0.1

API_PORT=4000
API_HOST=0.0.0.0
# The VM's public IP or domain, e.g. http://123.45.67.89:4000
API_PUBLIC_URL=REPLACE_WITH_YOUR_VM_PUBLIC_URL
# Comma-separated origins allowed to call this API (e.g. your frontend's URL)
CORS_ALLOWED_ORIGINS=REPLACE_WITH_YOUR_FRONTEND_ORIGIN

WORKER_CONCURRENCY=5
