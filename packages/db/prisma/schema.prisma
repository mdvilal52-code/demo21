generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Root of tenant isolation. Phase 1-5 enforced it at the application layer only
/// (every repository function takes a tenantId and filters by it explicitly).
/// Phase 6 adds the enforced backstop: Postgres Row Level Security policies
/// (see migration `..._add_security_engine`) keyed on the `app.tenant_id`
/// session setting that `withTenantContext()` (@ai-concierge/security) sets
/// per-transaction — so a bug that forgets a `WHERE tenantId` clause fails
/// closed at the database, not just in application code.
model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  conversations            Conversation[]
  auditEvents              AuditEvent[]
  intentRecords            IntentRecord[]
  dateLocationExtractions  DateLocationExtraction[]
  vehicles                 Vehicle[]
  vehicleDeterminations    VehicleDetermination[]
  missingInfoChecks        MissingInfoCheck[]
  users                    User[]
  refreshTokens            RefreshToken[]
  securityEvents           SecurityEvent[]

  @@map("tenants")
}

/// Human staff accounts (admin dashboard / internal tooling), distinct from
/// `Customer` (not yet modeled — journey Steps still identify customers by
/// `customerRef` on `Conversation`). Roles map to MASTER-PLAN.md §4's
/// escalation tiers: ADMIN is a superset, MANAGER=T3, OPS_AGENT=T2,
/// SECURITY=T4. T1 is the AI itself, never a human role.
enum UserRole {
  ADMIN
  MANAGER
  OPS_AGENT
  SECURITY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// `passwordHash` is an argon2id hash, never reversible. `mfaSecretCiphertext`
/// is an AES-256-GCM ciphertext (packages/security/src/crypto.ts) of the TOTP
/// seed, never the raw secret — field-level encryption for the one real
/// per-user secret this phase introduces (passport/licence-number encryption
/// applies once the document pipeline of the original phase-5 grouping is
/// built; see docs/PHASE-6.md §3).
model User {
  id                  String     @id @default(uuid())
  tenantId            String
  tenant              Tenant     @relation(fields: [tenantId], references: [id])
  email               String
  passwordHash        String
  role                UserRole
  status              UserStatus @default(ACTIVE)
  mfaEnabled          Boolean    @default(false)
  mfaSecretCiphertext String?
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  refreshTokens  RefreshToken[]
  securityEvents SecurityEvent[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Rotating refresh tokens: only `tokenHash` (SHA-256 of the opaque token) is
/// stored, never the raw token. `familyId` groups one rotation chain — reuse
/// of an already-rotated (revoked) member is a stolen-token signal and
/// revokes the whole family (see packages/security/src/authn/refreshTokens.ts).
model RefreshToken {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  tokenHash         String    @unique
  familyId          String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  ip                String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  MFA_ENROLLED
  MFA_FAILURE
  TOKEN_REUSE_DETECTED
  ACCOUNT_LOCKED
  PERMISSION_DENIED
  CROSS_TENANT_ATTEMPT
  SESSION_REVOKED
  ANOMALY_LOGIN_VELOCITY
  ANOMALY_MASS_EXPORT
  DLP_OUTBOUND_PII_DETECTED
}

enum SecuritySeverity {
  INFO
  WARNING
  CRITICAL
}

/// Append-only security event stream — the detection & response layer's
/// record, and the current T4 (Security/Compliance) escalation surface via
/// `GET /v1/security-events` until a full EscalationCase model exists
/// (that is the Event/Workflow Engine's concern, still unbuilt).
model SecurityEvent {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?             @relation(fields: [userId], references: [id])
  type      SecurityEventType
  severity  SecuritySeverity
  ip        String?
  userAgent String?
  metadata  Json
  createdAt DateTime          @default(now())

  @@index([tenantId])
  @@index([tenantId, severity])
  @@index([userId])
  @@map("security_events")
}

enum Channel {
  WHATSAPP
  WEB
  EMAIL
}

model Conversation {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  channel     Channel
  customerRef String
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  messages Message[]

  @@index([tenantId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  content        String
  createdAt      DateTime     @default(now())

  intentRecords            IntentRecord[]
  dateLocationExtractions  DateLocationExtraction[]
  vehicleDeterminations    VehicleDetermination[]
  missingInfoChecks        MissingInfoCheck[]

  @@index([conversationId])
  @@map("messages")
}

enum IntentType {
  ENQUIRY
  BOOKING_REQUEST
  AVAILABILITY_REQUEST
  PRICE_REQUEST
  DOCUMENT_REQUEST
  PAYMENT_REQUEST
  SUPPORT_REQUEST
  RETURN_REQUEST
  COMPLAINT
  UNKNOWN
}

enum IntentStatus {
  RECOGNIZED
  NEEDS_CLARIFICATION
}

/// One row per intent-recognition run against a message. Entities/flags/
/// modelMetadata are stored as-is from the (Zod-validated) engine output —
/// never raw customer PII beyond what the engine already extracted.
model IntentRecord {
  id                  String       @id @default(uuid())
  tenantId            String
  tenant              Tenant       @relation(fields: [tenantId], references: [id])
  messageId           String
  message             Message      @relation(fields: [messageId], references: [id])
  intentType          IntentType
  status              IntentStatus
  confidence          Float
  entities            Json
  missingFields       String[]
  clarificationPrompt String?
  flags               Json
  modelMetadata       Json
  createdAt           DateTime     @default(now())

  @@index([tenantId])
  @@index([messageId])
  @@map("intent_records")
}

/// Append-only. Written in the same transaction as the mutation it records.
model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  actor      String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  requestId  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("audit_events")
}

/// Backs idempotent handling of POST /v1/enquiries (and future mutating
/// endpoints): the same Idempotency-Key replays the stored response instead
/// of re-running the side effects.
model IdempotencyKey {
  key            String   @id
  tenantId       String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@map("idempotency_keys")
}

enum LocationType {
  AIRPORT
  HOTEL
  LANDMARK
  ADDRESS
  CITY_AREA
  UNKNOWN
}

/// Step 2 — Extract Dates & Location. One row per extraction run against a
/// message. `pickupLocation`/`dropoffLocation`/`ambiguities`/`validationErrors`/
/// `flags`/`modelMetadata` are stored as-is from the (Zod-validated)
/// TemporalValidationService output — the same "store the validated engine
/// output verbatim" convention as IntentRecord.
model DateLocationExtraction {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  messageId        String
  message          Message       @relation(fields: [messageId], references: [id])
  pickupDate       DateTime?
  returnDate       DateTime?
  timezone         String?
  pickupLocation   Json?
  dropoffLocation  Json?
  locationType     LocationType?
  confidence       Float
  ambiguities      Json
  validationErrors Json
  flags            Json
  modelMetadata    Json
  createdAt        DateTime      @default(now())

  @@index([tenantId])
  @@index([messageId])
  @@map("date_location_extractions")
}

enum VehicleCategory {
  SEDAN
  SUV
  COUPE
  CONVERTIBLE
  SPORTS
  VAN
}

enum LuxuryTier {
  PREMIUM
  LUXURY
  ULTRA_LUXURY
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

/// Catalog-level status only (is this fleet class offered at all right now) —
/// NOT a date-range booking calendar. Real per-date availability/holds are
/// journey Step 6, a distinct later phase.
enum VehicleAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

enum VehicleDeterminationStatus {
  RESOLVED
  NEEDS_CLARIFICATION
  UNSUPPORTED
}

/// Step 3 — Determine Vehicle. A fleet class/model catalog entry (e.g.
/// "Lamborghini Urus"), not an individual physical unit. `make`/`model` are
/// normalized to a canonical case at the repository layer before writing, so
/// the unique constraint is effectively case-insensitive without needing the
/// `citext` extension. Soft-deleted rows (`deletedAt` set) are excluded from
/// every repository query — they behave as if they never existed for
/// matching purposes, distinct from `active=false` (a real, known catalog
/// entry temporarily not offered) and `availabilityStatus` (a real, active
/// entry that is temporarily unavailable/in maintenance).
model Vehicle {
  id                 String                    @id @default(uuid())
  tenantId           String
  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  make               String
  model              String
  category           VehicleCategory
  luxuryTier         LuxuryTier
  seats              Int
  luggage            Int
  transmission       Transmission
  availabilityStatus VehicleAvailabilityStatus @default(AVAILABLE)
  /// Zod-validated PricingProfile (currency, dailyRate, weeklyRate?, depositAmount?) — a
  /// "budget hint" per MASTER-PLAN.md Step 3, not the real pricing engine (Step 8).
  pricingProfile     Json
  active             Boolean                   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  vehicleDeterminations VehicleDetermination[]

  @@unique([tenantId, make, model])
  @@index([tenantId])
  @@index([tenantId, category])
  @@map("vehicles")
}

/// One row per vehicle-determination run against a message — same
/// append-only-history convention as IntentRecord/DateLocationExtraction.
/// `resolvedVehicleId` is null whenever status is NEEDS_CLARIFICATION or
/// UNSUPPORTED; `alternatives` snapshots the real catalog entries offered at
/// decision time (never a fabricated vehicle).
model VehicleDetermination {
  id                String                     @id @default(uuid())
  tenantId          String
  tenant            Tenant                     @relation(fields: [tenantId], references: [id])
  messageId         String
  message           Message                    @relation(fields: [messageId], references: [id])
  resolvedVehicleId String?
  resolvedVehicle   Vehicle?                   @relation(fields: [resolvedVehicleId], references: [id])
  status            VehicleDeterminationStatus
  confidence        Float
  ambiguities       Json
  validationErrors  Json
  alternatives      Json
  flags             Json
  modelMetadata     Json
  createdAt         DateTime                   @default(now())

  @@index([tenantId])
  @@index([messageId])
  @@map("vehicle_determinations")
}

enum MissingInfoStatus {
  COMPLETE
  NEEDS_INFO
  EXPIRED
  NOT_APPLICABLE
}

/// Step 4 — Ask Missing Information. One row per completeness check against
/// a message — same append-only-history convention as IntentRecord/
/// DateLocationExtraction/VehicleDetermination. Reads what Steps 1-3 already
/// resolved; never re-parses raw text.
model MissingInfoCheck {
  id                  String            @id @default(uuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  messageId           String
  message             Message           @relation(fields: [messageId], references: [id])
  status              MissingInfoStatus
  collected           Json
  missingFields       Json
  clarificationPrompt String?
  expiresAt           DateTime
  flags               Json
  modelMetadata       Json
  createdAt           DateTime          @default(now())

  @@index([tenantId])
  @@index([messageId])
  @@map("missing_info_checks")
}
